{
  "name": "tablebooker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "server",
    "shared"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:server": "npm run start:dev --workspace=@tablebooker/server",
    "dev:customer": "npm run dev --workspace=@tablebooker/customer",
    "dev:portal": "npm run dev --workspace=@tablebooker/portal",
    "dev:admin": "npm run dev --workspace=@tablebooker/admin",
    "dev": "concurrently -n server,customer,portal,admin -c blue,green,magenta,yellow \"npm:dev:server\" \"npm:dev:customer\" \"npm:dev:portal\" \"npm:dev:admin\"",
    "build": "npm run build --workspace=@tablebooker/server && npm run build --workspace=@tablebooker/customer && npm run build --workspace=@tablebooker/portal && npm run build --workspace=@tablebooker/admin"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "^2.2.0"
    }
  }
}
