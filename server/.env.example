# ─── TableBooker API environment ─────────────────────────────────────────────
# Copy to server/.env for local dev. In production set these as real env vars
# (e.g. Render dashboard / render.yaml) — never commit real secrets.

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tablebooker?schema=public"

# REQUIRED IN PRODUCTION. Secret used to sign & verify JWTs. Must be a long
# random string (>= 32 chars) or the API refuses to boot in production.
# Generate one with:  openssl rand -hex 32
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"

# Access-token lifetime (optional; default 1d). e.g. 12h, 24h, 7d.
JWT_EXPIRES_IN="1d"

# Comma-separated browser origins allowed to call the API (CORS). Set to your
# deployed frontend URLs in production. Defaults to the local dev ports if unset.
# CORS_ORIGINS="https://app.example.com,https://admin.example.com,https://book.example.com"

# Public base URL the API is reachable at — used to build absolute upload URLs.
API_BASE_URL="http://localhost:4000"

# Directory uploaded images are written to and served from. Point at a mounted
# persistent disk in production (the default container FS is wiped on deploy).
# UPLOAD_DIR="/var/data/uploads"

# Seed credentials — REQUIRED to seed a production database (>= 8 chars each).
# In development the seed falls back to the demo passwords documented in README.
# SEED_ADMIN_PASSWORD="use-a-strong-password"
# SEED_OWNER_PASSWORD="use-a-strong-password"

# Set to "production" on the live server.
# NODE_ENV="production"

PORT=4000
